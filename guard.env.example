# ===== gmail-guard =====
# Stufe: read = nur lesen | organize = + aufräumen | full = + Entwürfe
GUARD_MODE=read

# aus scripts/gen_secrets.py
GUARD_TOKEN_KEY=
MCP_BEARER_TOKEN=

# verschlüsselte Gmail-Zugänge (schreibt scripts/setup.py für dich – nicht von Hand ändern)
GUARD_ACCOUNTS=

# ---- Masse-Bremse (pro Konto, pro Zeitfenster) ----
BRAKE_WINDOW_MIN=60
BRAKE_TRASH=20
BRAKE_SPAM=20
BRAKE_ARCHIVE=50
DAILY_TRASH_LIMIT=100
BULK_TTL_HOURS=2

# ---- Größen ----
MAX_BODY_CHARS=20000
MAX_ATTACHMENT_MB=15
MAX_ATTACHMENT_CHARS=40000

HERMES_LABEL=Hermes-Entwurf
TZ=Europe/Berlin
